# Всё, что не существующий файл или каталог, уходит в единственную точку входа.

# Каталоги не отдаются списком: файлы публичных ассетов доступны по имени и так, а вот
# их перечень наружу уходить не должен.
Options -Indexes

# Правила mod_rewrite стоят внутри обёртки: на хостинге без модуля их не отключить —
# неизвестная директива обваливает весь сайт 500-м ещё на разборе конфигурации.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Фактический ответ замку — 404: файл лежит в docroot, и без этого правила он мог бы
    # уйти наружу как обычный ответ файла со штампом времени установки. [NC] обязателен:
    # запрос /INSTALL.LOCK на файловых системах без регистра (Windows при локальной
    # приёмке) минует правило без флага и уйдёт в front-controller.
    RewriteRule ^install\.lock$ - [R=404,L,NC]

    # http→https для боевого хоста: без редиректа первый заход по http даёт сессию, в
    # которую Secure-кука просто не ляжет. Протокол берётся только из самого соединения
    # (%{HTTPS}): условий по подставляемым заголовкам здесь нет намеренно — их ставит
    # клиент, и решение о протоколе уехало бы наружу.
    #
    # Редирект обязан пропускать четыре адреса, иначе он ломает то, без чего сайт не
    # запускается: пустой Host (запрос HTTP/1.0 без заголовка Host даёт битый Location),
    # localhost и 127.0.0.1 (локальная приёмка живёт на http без сертификата), голые
    # IP-адреса (сертификата на адрес не выпускают вовсе) и /.well-known — путь проверки
    # домена, по которому сертификат получают по http до того, как https работает.
    #
    # Код 302, а не 301: постоянный редирект браузер кэширует и отозвать его нельзя, а
    # сертификат на виртуальном хостинге появляется позже самого сайта.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^$
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^[0-9.]+(:[0-9]+)?$
    RewriteCond %{REQUEST_URI} !^/\.well-known
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=302,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Заголовки безопасности дублируются в bootstrap.php: не каждый хостинг даёт mod_headers.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Замок установщика не раздаётся: при выключенном mod_rewrite отказ даёт этот блок (403),
# а правило выше отвечает 404. Обе ветки обёрнуты: «Require all denied» без mod_authz_core —
# неизвестная директива, то есть 500 на весь сайт, а директивы 2.2 работают ровно там, где
# mod_authz_core отсутствует. Сравнение имени регистронезависимо (?i): на файловой системе
# без регистра файл мог быть поднят как «INSTALL.LOCK», и точное имя в <Files> его бы не
# задело.
<FilesMatch "(?i)^install\.lock$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
