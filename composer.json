{
  "name": "purrfect/cms",
  "description": "CMS на PHP и MySQL для виртуального хостинга",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.4",
    "phpstan/phpstan": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.64"
  },
  "autoload": {
    "psr-4": {
      "Cms\\Core\\": "core/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cms\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
