# Боевой конфиг с паролями в репозиторий не попадает — только образец.
/config.php

/vendor/
/node_modules/
/.php-cs-fixer.cache
/.phpunit.result.cache

# Замок установщика и временные файлы сборки.
/public/install.lock
/backup/

# Журнал ошибок: в нём тексты исключений и адреса — наружу в git он не идёт.
/core/storage/*.log

# Каталог загрузок пустой в репозитории: файлы кладут люди на сервере.
# Повторное включение обязано идти по одному имени — `git` не заходит в каталог,
# который уже исключён маской `*`.
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/.htaccess

# Каталог картинок (обложки «Новостей» и всё, что грузит админка) обязан быть в репозитории
# пустым: без него первая же загрузка падает. Маска `/public/uploads/*` до содержимого этого
# каталога не достреливает (`*` не переходит через `/`), а разрешение каталога возвращает git
# внутрь него — поэтому содержимое запрещено своей маской, и только потом `.gitkeep` включён
# обратно по имени. Порядок строк значим: решает последнее совпадение.
!/public/uploads/images/
/public/uploads/images/*
!/public/uploads/images/.gitkeep

# Каталог некартинок — сюда админка кладёт вложения и документы. Тот же порядок строк и та же
# причина: пустой каркас в репозитории, содержимое живёт только на сервере.
!/public/uploads/files/
/public/uploads/files/*
!/public/uploads/files/.gitkeep

# Случайно положенный рядом секрет не должен дожить до коммита: `.env*` — файлы окружения любых
# форм, `*.pem` и `id_rsa*` — ключи. Конкретные пути (боевой `config.php`, замок установщика)
# закрыты своими строками выше; эти — страховка от того, чего в репозитории пока нет.
/.env
/.env.*
*.pem
*.key
id_rsa
id_rsa.*
