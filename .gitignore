# Боевой конфиг с паролями в репозиторий не попадает — только образец.
/config.php

/vendor/
/node_modules/
/.php-cs-fixer.cache
/.phpunit.result.cache

# Замок установщика и временные файлы сборки.
/public/install.lock
/backup/

# Журнал ошибок: в нём тексты исключений и адреса — наружу в git он не идёт.
/core/storage/*.log

# Каталог загрузок пустой в репозитории: картинки кладут люди на сервере.
# Повторное включение обязано идти по одному имени — `git` не заходит в каталог,
# который уже исключён маской `*`.
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/.htaccess

# Каталог обложек «Новостей» обязан быть в репозитории пустым: без него первая же загрузка падает.
# Маска `/public/uploads/*` до содержимого этого каталога не достреливает (`*` не переходит через
# `/`), а разрешение каталога возвращает git внутрь него — поэтому содержимое запрещено своей
# маской, и только потом `.gitkeep` включён обратно по имени.
!/public/uploads/news/
/public/uploads/news/*
!/public/uploads/news/.gitkeep
