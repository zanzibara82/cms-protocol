parameters:
  level: 6
  paths:
    - core
    - admin
    - theme
    - apps
    - public
    - tests
    # Хостеровые скрипты (`make-og-default.php`, `hosting-probe.php`) исполняют разрушительные
    # действия на выкладке: без этого пути их типовой контроль не идёт нигде — `php -l` и
    # PHP-CS-Fixer их видят, а анализ ошибок типов — нет.
    - scripts
  # Корневые `config.sample.php` и `.php-cs-fixer.dist.php` в анализ не входят сознательно:
  # первый — шаблон, значения в который вводит оператор на хостинге (в репозитории он неполный
  # по определению, и анализ по нему не о чём), а второй — конфиг инструмента, а не код CMS.
  excludePaths:
    analyse:
      - public/assets/*
  # Глобальные константы lib-файлов в реестр символов попадают только при явном включении
  # файла в набор сканирования: paths сам по себе константы не резолвит (проверено на
  # NEWS_BLOCK_OPS: единичный argv-прогон теста ловит «not found», пара «тест + admin.php» — нет).
  scanFiles:
    - apps/news/lib/admin.php
  treatPhpDocTypesAsCertain: false
